#!/usr/bin/env bash
# Runner for the vendored HyperFrames CLI (fully-installed node_modules, no network).
#
# Uses the repo's vendored Node.js when available, and points the CLI at the
# vendored chrome-headless-shell and FFmpeg so renders work offline:
#   HYPERFRAMES_BROWSER_PATH -> vendor/chrome-headless-shell/<platform>/...
#   HYPERFRAMES_FFMPEG_PATH / HYPERFRAMES_FFPROBE_PATH -> vendor/ffmpeg/<platform>/bin
#
# Override with TOOLS_PLATFORM=linux-x64|linux-arm64, or set the HYPERFRAMES_*
# variables yourself to take precedence.
set -euo pipefail
root="$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)"
readonly root

platform="${TOOLS_PLATFORM:-}"
if [ -z "$platform" ]; then
  case "$(uname -s)-$(uname -m)" in
    Linux-x86_64) platform=linux-x64 ;;
    Linux-aarch64|Linux-arm64) platform=linux-arm64 ;;
    *) printf 'Unsupported platform: %s-%s\n' "$(uname -s)" "$(uname -m)" >&2; exit 1 ;;
  esac
fi

node_bin="$root/node/$platform/bin/node"
[ -x "$node_bin" ] || node_bin="$(command -v node)"
[ -n "$node_bin" ] || { printf 'No node found (looked at %s and PATH)\n' "$root/node/$platform/bin/node" >&2; exit 1; }

# --- vendored browser (chrome-headless-shell) ---
# chrome-launch.sh supplies the vendored system libraries on hosts that lack
# Chrome's dependencies (minimal containers, sandboxes, NixOS without FHS /lib).
if [ -x "$root/vendor/chrome-launch.sh" ] && [ -z "${HYPERFRAMES_BROWSER_PATH:-}" ]; then
  export HYPERFRAMES_BROWSER_PATH="$root/vendor/chrome-launch.sh"
fi
export HYPERFRAMES_NO_AUTO_INSTALL="${HYPERFRAMES_NO_AUTO_INSTALL:-1}"

# --- vendored FFmpeg ---
if [ -x "$root/vendor/ffmpeg/$platform/bin/ffmpeg" ]; then
  export HYPERFRAMES_FFMPEG_PATH="${HYPERFRAMES_FFMPEG_PATH:-$root/vendor/ffmpeg/$platform/bin/ffmpeg}"
  export HYPERFRAMES_FFPROBE_PATH="${HYPERFRAMES_FFPROBE_PATH:-$root/vendor/ffmpeg/$platform/bin/ffprobe}"
  case ":$PATH:" in *":$root/vendor/ffmpeg/$platform/bin:"*) ;; *)
    export PATH="$root/vendor/ffmpeg/$platform/bin:$PATH" ;; esac
fi

exec "$node_bin" "$root/hyperframes/cli/node_modules/hyperframes/dist/cli.js" "$@"
