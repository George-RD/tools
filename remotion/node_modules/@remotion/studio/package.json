{
	"repository": {
		"url": "https://github.com/remotion-dev/remotion/tree/main/packages/studio"
	},
	"name": "@remotion/studio",
	"version": "4.0.526",
	"description": "APIs for interacting with the Remotion Studio",
	"main": "dist",
	"scripts": {
		"lint": "eslint src",
		"make": "tsgo -d && bun --env-file=../.env.bundle bundle.ts",
		"test": "bun test src",
		"formatting": "oxfmt src --check",
		"format": "oxfmt src"
	},
	"author": "Jonny Burger <jonny@remotion.dev>",
	"contributors": [],
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/remotion-dev/remotion/issues"
	},
	"peerDependencies": {
		"@remotion/video-matting": "4.0.526",
		"@remotion/whisper-webgpu": "4.0.526",
		"react": ">=16.8.0",
		"react-dom": ">=16.8.0"
	},
	"peerDependenciesMeta": {
		"@remotion/video-matting": {
			"optional": true
		},
		"@remotion/whisper-webgpu": {
			"optional": true
		}
	},
	"dependencies": {
		"@jridgewell/trace-mapping": "0.3.31",
		"@remotion/canvas": "4.0.526",
		"@remotion/captions": "4.0.526",
		"@remotion/media": "4.0.526",
		"@remotion/media-utils": "4.0.526",
		"@remotion/player": "4.0.526",
		"@remotion/renderer": "4.0.526",
		"@remotion/studio-codemods": "4.0.526",
		"@remotion/studio-protocol": "4.0.526",
		"@remotion/studio-shared": "4.0.526",
		"@remotion/timeline-utils": "4.0.526",
		"@remotion/web-renderer": "4.0.526",
		"@remotion/zod-types": "4.0.526",
		"@tanstack/react-virtual": "3.14.9",
		"mediabunny": "1.56.1",
		"memfs": "3.4.3",
		"open": "8.4.2",
		"prismjs": "1.30.0",
		"remotion": "4.0.526",
		"semver": "7.5.3",
		"zod": "4.5.4"
	},
	"devDependencies": {
		"@happy-dom/global-registrator": "14.5.1",
		"@remotion/eslint-config-internal": "4.0.526",
		"@remotion/video-matting": "4.0.526",
		"@remotion/whisper-webgpu": "4.0.526",
		"@testing-library/react": "16.1.0",
		"@types/prismjs": "1.26.4",
		"@types/semver": "7.5.3",
		"@typescript/native-preview": "7.0.0-dev.20260217.1",
		"eslint": "9.19.0",
		"react": "19.2.3",
		"react-dom": "19.2.3"
	},
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./dist/index.d.ts",
			"require": "./dist/index.js",
			"module": "./dist/esm/index.mjs",
			"import": "./dist/esm/index.mjs"
		},
		"./renderEntry": {
			"types": "./dist/renderEntry.d.ts",
			"require": "./dist/renderEntry.js",
			"module": "./dist/esm/renderEntry.mjs",
			"import": "./dist/esm/renderEntry.mjs"
		},
		"./internals": {
			"types": "./dist/internals.d.ts",
			"require": "./dist/internals.js",
			"module": "./dist/esm/internals.mjs",
			"import": "./dist/esm/internals.mjs"
		},
		"./previewEntry": {
			"types": "./dist/previewEntry.d.ts",
			"require": "./dist/previewEntry.js",
			"module": "./dist/esm/previewEntry.mjs",
			"import": "./dist/esm/previewEntry.mjs"
		}
	},
	"homepage": "https://www.remotion.dev/docs/studio/api",
	"typesVersions": {
		">=1.0": {
			"renderEntry": [
				"./dist/renderEntry.d.ts"
			],
			"internals": [
				"./dist/internals.d.ts"
			],
			"previewEntry": [
				"./dist/previewEntry.d.ts"
			]
		}
	}
}
