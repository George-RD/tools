{
	"repository": {
		"url": "https://github.com/remotion-dev/remotion/tree/main/packages/canvas"
	},
	"name": "@remotion/canvas",
	"version": "4.0.526",
	"description": "Headless primitives for Remotion authoring interfaces",
	"main": "dist/index.cjs",
	"types": "dist/index.d.ts",
	"module": "dist/esm/index.mjs",
	"type": "module",
	"scripts": {
		"test": "bun test src/test",
		"formatting": "oxfmt src --check",
		"format": "oxfmt src",
		"lint": "eslint src",
		"watch": "tsgo -w",
		"make": "tsgo && bun --env-file=../.env.bundle bundle.ts"
	},
	"author": "Jonny Burger <jonny@remotion.dev>",
	"contributors": [],
	"license": "Remotion License",
	"bugs": {
		"url": "https://github.com/remotion-dev/remotion/issues"
	},
	"dependencies": {
		"@remotion/player": "4.0.526",
		"remotion": "4.0.526"
	},
	"peerDependencies": {
		"react": ">=16.8.0",
		"react-dom": ">=16.8.0"
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./dist/index.d.ts",
			"require": "./dist/index.cjs",
			"module": "./dist/esm/index.mjs",
			"import": "./dist/esm/index.mjs"
		}
	},
	"devDependencies": {
		"@happy-dom/global-registrator": "14.5.1",
		"@remotion/eslint-config-internal": "4.0.526",
		"@testing-library/react": "16.1.0",
		"@typescript/native-preview": "7.0.0-dev.20260217.1",
		"eslint": "9.19.0",
		"react": "19.2.3",
		"react-dom": "19.2.3"
	},
	"keywords": [
		"remotion",
		"canvas",
		"timeline"
	],
	"publishConfig": {
		"access": "public"
	}
}
